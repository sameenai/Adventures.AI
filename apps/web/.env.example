# ---------------------------------------------------------------------------
# Local dev — no Docker required.
# Prerequisites: brew install postgresql redis && make setup
# The `make setup` target creates the 'summit' role and 'summitsocial' DB.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://summit:summit@localhost:5432/summitsocial
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=<generate-with-openssl>
# Production: https://basecamper.ai
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit opt-in for the any-email dev login form (never set in deployed envs)
ENABLE_DEV_LOGIN=true

# Comma-separated emails granted the admin dashboard + moderation powers
ADMIN_EMAILS=

# OpenAI
OPENAI_API_KEY=

# Flight APIs
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net/apiservices
SKYSCANNER_AFFILIATE_ID=

# Stripe (required before charging money)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Encryption (32-byte hex key for AES-256-GCM, used to encrypt stored API keys)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret for the scheduled-jobs endpoint (/api/jobs/*)
# Generate with: openssl rand -hex 24
JOBS_SECRET=

# Maps

# Transactional email (Resend). Unset = emails recorded as SKIPPED in EmailLog,
# nothing sent — safe default for dev/preview.
RESEND_API_KEY=
EMAIL_FROM="Basecamper <noreply@basecamper.ai>"
