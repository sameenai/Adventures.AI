# ---------------------------------------------------------------------------
# Local dev — no Docker required.
# Prerequisites: brew install postgresql redis && make setup
# The `make setup` target creates the 'summit' role and 'summitsocial' DB.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://summit:summit@localhost:5432/summitsocial
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=<generate-with-openssl>
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# Flight APIs
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net/apiservices

# Storage
S3_BUCKET=summitsocial-uploads
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe (v2 - optional for MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Encryption (32-byte hex key for AES-256-GCM, used to encrypt stored API keys)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=
