generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  avatarUrl        String?
  bio              String?
  instagramUrl     String?
  twitterUrl       String?
  websiteUrl       String?
  openAiApiKey     String?           @db.Text
  // Display hint (last 4 chars) precomputed at save time so settings pages
  // never need to decrypt the stored key just to render "sk-…abcd".
  openAiApiKeyHint String?
  plan             Plan              @default(FREE)
  stripeCustomerId String?           @unique
  stripeSubId      String?           @unique
  // Consent & legal acceptance records (see /privacy, /terms)
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?

  aiCreditsUsed    Int               @default(0)
  aiCreditsResetAt DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  adventures       Adventure[]
  votes            Vote[]
  itineraries      Itinerary[]
  comments         Comment[]
  following        Follow[]          @relation("Follower")
  followers        Follow[]          @relation("Following")
  bookmarks        Bookmark[]
  notifications    Notification[]
  collections      Collection[]
  flightBookings   FlightBooking[]
  emailLogs        EmailLog[]
  analyticsEvents  AnalyticsEvent[]
  messageFeedback  MessageFeedback[]
  travelerProfile  TravelerProfile?
  tripEvents       TripEvent[]
  searchEvents     SearchEvent[]
  cadenceRecs      CadenceRecommendation[]
  commentReactions CommentReaction[]
  adventureViews   AdventureView[]
}

model Adventure {
  id            String     @id @default(cuid())
  title         String
  description   String     @db.Text
  location      String
  country       String
  continent     String
  category      Category
  difficulty    Difficulty
  durationDays  Int
  coverImageUrl  String
  galleryImages  String[] @default([])
  albumUrl       String?
  albumPlatform  String?
  /// Cover photo provenance: { artist, license, sourceUrl } — required for
  /// CC-licensed imagery (Wikimedia Commons); rendered as a credit line.
  imageAttribution Json?
  highlights    String[]
  gear          String[]
  bestMonths    Int[]
  climate       String[] @default([])
  estimatedCost Int?
  gpxTrackUrl   String?
  latitude      Float?
  longitude     Float?
  published     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         Vote[]
  comments      Comment[]
  tags          Tag[]
  voteCount     Int        @default(0)
  viewCount     Int        @default(0)
  bookmarks       Bookmark[]
  collectionItems CollectionItem[]
  views           AdventureView[]
  tripEvents      TripEvent[]
  cadenceRecs     CadenceRecommendation[]
  operatorId      String?
  operator        Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([voteCount(sort: Desc), id])
  @@index([createdAt(sort: Desc), id])
  @@index([durationDays, id])
  @@index([category])
  @@index([continent])
  @@index([difficulty])
}

model Vote {
  id          String    @id @default(cuid())
  userId      String
  adventureId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([userId, adventureId])
  @@index([createdAt(sort: Desc)])
}

model Comment {
  id          String            @id @default(cuid())
  body        String            @db.Text
  userId      String
  adventureId String
  parentId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure         @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  parent      Comment?          @relation("Replies", fields: [parentId], references: [id])
  replies     Comment[]         @relation("Replies")
  reactions   CommentReaction[]
}

model CommentReaction {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  adventures Adventure[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Bookmark {
  id          String    @id @default(cuid())
  userId      String
  adventureId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([userId, adventureId])
}

model Itinerary {
  id             String          @id @default(cuid())
  title          String
  description    String?         @db.Text
  startDate      DateTime?
  endDate        DateTime?
  budget         Int?
  travellers     Int             @default(1)
  status         ItineraryStatus @default(DRAFT)
  chatHistory    Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days           ItineraryDay[]
  flightBookings FlightBooking[]
  messageFeedback MessageFeedback[]
}

model ItineraryDay {
  id          String    @id @default(cuid())
  dayNumber   Int
  title       String
  description String?   @db.Text
  activities  Json
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model FlightBooking {
  id                    String              @id @default(cuid())
  status                FlightBookingStatus @default(SELECTED)
  provider              String
  providerRef           String
  origin                String
  destination           String
  departureAt           DateTime
  arrivalAt             DateTime
  airline               String
  flightNumber          String
  priceGBP              Int
  currency              String              @default("GBP")
  cabinClass            String              @default("economy")
  deepLink              String?
  // Return leg for round trips (a single-row simplification until multi-leg
  // segments are needed; segments Json can hold connections).
  returnDepartureAt     DateTime?
  returnArrivalAt       DateTime?
  segments              Json?
  passengers            Json?
  stripePaymentIntentId String?
  orderRef              String?
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryId           String?
  itinerary             Itinerary?          @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

// SELECTED: user picked an offer. PRICE_CONFIRMED: re-validated with the
// provider. PAID: money captured. TICKETED: PNR issued. Terminal states:
// CANCELLED, REFUNDED. Transitions are enforced in the API layer.
enum FlightBookingStatus {
  SELECTED
  PRICE_CONFIRMED
  PAID
  TICKETED
  CANCELLED
  REFUNDED
}

enum Category {
  TREKKING
  MOUNTAINEERING
  CYCLING
  KAYAKING
  DIVING
  SAFARI
  SKIING
  SURFING
  ROAD_TRIP
  CULTURAL
  MULTI_SPORT
  EXPEDITION
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
  EXPEDITION_GRADE
}

enum ItineraryStatus {
  DRAFT
  PLANNING
  BOOKED
  COMPLETED
}

enum Plan {
  FREE
  PRO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  linkUrl   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

enum NotificationType {
  NEW_COMMENT
  NEW_FOLLOWER
  NEW_VOTE
  ADVENTURE_PUBLISHED
  SYSTEM
  TRIP_DUE
  SEASON_ALERT
  BOOKING_CONFIRMED
}

model Collection {
  id        String           @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  adventureId  String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  adventure    Adventure  @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([collectionId, adventureId])
}

model AdventureView {
  id          String    @id @default(cuid())
  adventureId String
  userId      String?
  fingerprint String
  createdAt   DateTime  @default(now())
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([adventureId, fingerprint])
  @@index([adventureId])
}

// Ledger of processed Stripe webhook events. Stripe retries deliveries; the
// unique id makes every handler idempotent under replays and retries.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// One row per scheduled-job execution (POST /api/jobs/[job]) so a silently
// failing schedule is visible and double-runs are auditable.
// The person or company that actually runs a listed adventure. Surfaced on
// the adventure page ("run by X — book direct") and used by the partner
// deep-link rail; nullable because most catalog entries are community routes
// with no single operator.
model Operator {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  website            String?
  // Template for direct-booking links; {date} and {pax} placeholders are
  // filled from the itinerary at render time.
  bookingUrlTemplate String?
  description        String?     @db.Text
  adventures         Adventure[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

// Every transactional email the platform attempts, whether or not a provider
// is configured — the audit trail for "did the confirmation actually send".
// Cascade-deleted with the user so account deletion removes the address.
model EmailLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  toEmail    String
  template   String
  subject    String
  status     EmailStatus
  providerId String?
  error      String?
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([template, createdAt(sort: Desc)])
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

// Product analytics: one row per funnel event, captured server-side at the
// moment the thing actually happened (payment via webhook, not button click).
// Signed-in events key on the user (cascade-deleted with the account);
// anonymous client events carry only the daily-rotating salted viewer key.
// Props hold small primitive facts, never free text or PII.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonId    String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// The AI quality feedback loop: a thumbs rating on a specific assistant
// reply, snapshotting the conversation up to that point so a bad answer can
// be replayed as an eval case (evals/from-feedback.ts). Cascade-deleted with
// the user; the transcript snapshot lives here, not in analytics.
model MessageFeedback {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryId  String?
  itinerary    Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  /// Index of the assistant message in chatHistory this rates.
  messageIndex Int
  rating       FeedbackRating
  comment      String?   @db.Text
  /// Conversation snapshot up to and including the rated reply.
  transcript   Json
  /// Set when an eval case has been generated from this row.
  exportedAt   DateTime?
  createdAt    DateTime  @default(now())

  /// One rating per (user, itinerary, message) — re-rating upserts in place.
  /// itineraryId is nullable (SetNull keeps rows after itinerary deletion);
  /// NULLs are distinct in Postgres, which is fine: orphaned rows are
  /// historical and no longer written to.
  @@unique([userId, itineraryId, messageIndex])
  @@index([rating, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

enum FeedbackRating {
  UP
  DOWN
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     String // RUNNING | SUCCEEDED | FAILED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  stats      Json?

  @@index([jobName, startedAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Travel cadence substrate: stated preferences, trip history anchor, captured
// demand, and persisted recommendations (see /next-trip and the cadence jobs).
// ---------------------------------------------------------------------------

model TravelerProfile {
  id                  String      @id @default(cuid())
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeAirport         String? // IATA
  homeCountry         String?
  preferredCategories Category[]  @default([])
  maxDifficulty       Difficulty?
  typicalDurationDays Int?
  budgetBandPence     Int?
  // "I'm up for a trip every N months" — stated by the user, inferred later.
  cadenceMonths       Int         @default(6)
  fitnessLevel        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

// The anchor the cadence clock ticks from: real trips taken.
model TripEvent {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source             TripEventSource
  adventureId        String?
  adventure          Adventure?      @relation(fields: [adventureId], references: [id], onDelete: SetNull)
  itineraryId        String?
  destinationCountry String?
  startedAt          DateTime
  endedAt            DateTime?
  createdAt          DateTime        @default(now())

  @@unique([userId, adventureId, source])
  @@index([userId, startedAt(sort: Desc)])
}

enum TripEventSource {
  MARKED_DONE
  ITINERARY_COMPLETED
  FLIGHT_BOOKED
  IMPORTED
}

// Captured demand: what people search for (previously parsed and discarded).
model SearchEvent {
  id          String            @id @default(cuid())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  source      SearchEventSource
  query       String?
  filters     Json?
  resultCount Int?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

enum SearchEventSource {
  ADVENTURE_LIST
  CHAT
  FLIGHTS
}

// Persisted per-window picks: makes nudges idempotent, explains "why am I
// seeing this", and gives the scorer a feedback loop via status transitions.
model CadenceRecommendation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventureId String
  adventure   Adventure        @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  score       Float
  reasons     Json
  windowStart DateTime
  status      CadenceRecStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime         @default(now())

  @@unique([userId, adventureId, windowStart])
  @@index([userId, windowStart(sort: Desc)])
}

enum CadenceRecStatus {
  PENDING
  SENT
  CLICKED
  PLANNED
  DISMISSED
}
