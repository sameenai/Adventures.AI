generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  avatarUrl        String?
  bio              String?
  instagramUrl     String?
  twitterUrl       String?
  websiteUrl       String?
  openAiApiKey     String?           @db.Text
  // Display hint (last 4 chars) precomputed at save time so settings pages
  // never need to decrypt the stored key just to render "sk-…abcd".
  openAiApiKeyHint String?
  plan             Plan              @default(FREE)
  stripeCustomerId String?           @unique
  stripeSubId      String?           @unique
  // Consent & legal acceptance records (see /privacy, /terms)
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?

  aiCreditsUsed    Int               @default(0)
  aiCreditsResetAt DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  adventures       Adventure[]
  votes            Vote[]
  itineraries      Itinerary[]
  comments         Comment[]
  following        Follow[]          @relation("Follower")
  followers        Follow[]          @relation("Following")
  bookmarks        Bookmark[]
  notifications    Notification[]
  collections      Collection[]
  flightBookings   FlightBooking[]
  commentReactions CommentReaction[]
  adventureViews   AdventureView[]
}

model Adventure {
  id            String     @id @default(cuid())
  title         String
  description   String     @db.Text
  location      String
  country       String
  continent     String
  category      Category
  difficulty    Difficulty
  durationDays  Int
  coverImageUrl  String
  galleryImages  String[] @default([])
  albumUrl       String?
  albumPlatform  String?
  highlights    String[]
  gear          String[]
  bestMonths    Int[]
  climate       String[] @default([])
  estimatedCost Int?
  gpxTrackUrl   String?
  latitude      Float?
  longitude     Float?
  published     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         Vote[]
  comments      Comment[]
  tags          Tag[]
  voteCount     Int        @default(0)
  viewCount     Int        @default(0)
  bookmarks       Bookmark[]
  collectionItems CollectionItem[]
  views           AdventureView[]

  @@index([voteCount(sort: Desc), id])
  @@index([createdAt(sort: Desc), id])
  @@index([durationDays, id])
  @@index([category])
  @@index([continent])
  @@index([difficulty])
}

model Vote {
  id          String    @id @default(cuid())
  userId      String
  adventureId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([userId, adventureId])
  @@index([createdAt(sort: Desc)])
}

model Comment {
  id          String            @id @default(cuid())
  body        String            @db.Text
  userId      String
  adventureId String
  parentId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure         @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  parent      Comment?          @relation("Replies", fields: [parentId], references: [id])
  replies     Comment[]         @relation("Replies")
  reactions   CommentReaction[]
}

model CommentReaction {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  adventures Adventure[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Bookmark {
  id          String    @id @default(cuid())
  userId      String
  adventureId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([userId, adventureId])
}

model Itinerary {
  id             String          @id @default(cuid())
  title          String
  description    String?         @db.Text
  startDate      DateTime?
  endDate        DateTime?
  budget         Int?
  travellers     Int             @default(1)
  status         ItineraryStatus @default(DRAFT)
  chatHistory    Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days           ItineraryDay[]
  flightBookings FlightBooking[]
}

model ItineraryDay {
  id          String    @id @default(cuid())
  dayNumber   Int
  title       String
  description String?   @db.Text
  activities  Json
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model FlightBooking {
  id                    String              @id @default(cuid())
  status                FlightBookingStatus @default(SELECTED)
  provider              String
  providerRef           String
  origin                String
  destination           String
  departureAt           DateTime
  arrivalAt             DateTime
  airline               String
  flightNumber          String
  priceGBP              Int
  currency              String              @default("GBP")
  cabinClass            String              @default("economy")
  deepLink              String?
  // Return leg for round trips (a single-row simplification until multi-leg
  // segments are needed; segments Json can hold connections).
  returnDepartureAt     DateTime?
  returnArrivalAt       DateTime?
  segments              Json?
  passengers            Json?
  stripePaymentIntentId String?
  orderRef              String?
  userId                String?
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryId           String?
  itinerary             Itinerary?          @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

// SELECTED: user picked an offer. PRICE_CONFIRMED: re-validated with the
// provider. PAID: money captured. TICKETED: PNR issued. Terminal states:
// CANCELLED, REFUNDED. Transitions are enforced in the API layer.
enum FlightBookingStatus {
  SELECTED
  PRICE_CONFIRMED
  PAID
  TICKETED
  CANCELLED
  REFUNDED
}

enum Category {
  TREKKING
  MOUNTAINEERING
  CYCLING
  KAYAKING
  DIVING
  SAFARI
  SKIING
  SURFING
  ROAD_TRIP
  CULTURAL
  MULTI_SPORT
  EXPEDITION
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
  EXPEDITION_GRADE
}

enum ItineraryStatus {
  DRAFT
  PLANNING
  BOOKED
  COMPLETED
}

enum Plan {
  FREE
  PRO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  linkUrl   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

enum NotificationType {
  NEW_COMMENT
  NEW_FOLLOWER
  NEW_VOTE
  ADVENTURE_PUBLISHED
  SYSTEM
}

model Collection {
  id        String           @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  adventureId  String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  adventure    Adventure  @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([collectionId, adventureId])
}

model AdventureView {
  id          String    @id @default(cuid())
  adventureId String
  userId      String?
  fingerprint String
  createdAt   DateTime  @default(now())
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([adventureId, fingerprint])
  @@index([adventureId])
}

// Ledger of processed Stripe webhook events. Stripe retries deliveries; the
// unique id makes every handler idempotent under replays and retries.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// One row per scheduled-job execution (POST /api/jobs/[job]) so a silently
// failing schedule is visible and double-runs are auditable.
model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     String // RUNNING | SUCCEEDED | FAILED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  stats      Json?

  @@index([jobName, startedAt(sort: Desc)])
}
